<!doctype html>
<!--
  ============================================================
  PORTAFOLIO NARANJO'S — versión en un solo archivo HTML
  ============================================================
  Cómo editarlo:
  1. Abre este archivo con cualquier editor de texto (VS Code,
     Notepad++, Bloc de notas) o con un editor online.
  2. Los textos están escritos directamente en el HTML.
     Busca los comentarios que dicen "EDITA AQUÍ".
  3. Las fotos son enlaces (atributo src). Si quieres usar tus
     propias imágenes, sube la foto a internet (o ponla en la
     misma carpeta) y cambia la dirección.
  4. Para ver los cambios guarda el archivo y ábrelo en el navegador.
  ============================================================
-->
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Naranjo's — Santiago Naranjo | Portafolio creativo</title>
    <meta
      name="description"
      content="Portafolio de Santiago Naranjo: publicidad, marketing digital, creatividad y fotografía. Proyectos del semestre, servicios y contacto."
    />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <style>
      /* ========== 1. COLORES Y TIPOGRAFÍA (cámbialos aquí) ========== */
      :root {
        --bg: #0a0a0a;
        --fg: #f5f5f5;
        --muted: #a3a3a3;
        --card: #121212;
        --border: #292929;
        --primary: #ff6600;

        --font-display: "Archivo Black", "Archivo", sans-serif;
        --font-body: "Inter", system-ui, sans-serif;
        --font-mono: "JetBrains Mono", monospace;
      }

      /* ========== 2. BASE ========== */
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 80px;
      }

      body {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      img {
        display: block;
        max-width: 100%;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      ul {
        list-style: none;
      }

      ::selection {
        background: var(--primary);
        color: #0a0a0a;
      }

      .wrap {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px;
      }

      @media (min-width: 640px) {
        .wrap {
          padding: 0 40px;
        }
      }

      .eyebrow {
        font-family: var(--font-mono);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.28em;
        color: var(--primary);
      }

      .display {
        font-family: var(--font-display);
        text-transform: uppercase;
        line-height: 0.95;
        letter-spacing: -0.01em;
      }

      .orange {
        color: var(--primary);
      }

      section {
        border-top: 1px solid var(--border);
      }

      .section-pad {
        padding: 80px 0;
      }

      @media (min-width: 1024px) {
        .section-pad {
          padding: 112px 0;
        }
      }

      /* ========== 3. BARRA SUPERIOR ========== */
      .progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 2px;
        width: 0;
        background: var(--primary);
        z-index: 60;
      }

      .site-header {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 50;
        background: rgba(10, 10, 10, 0.82);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(41, 41, 41, 0.7);
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 16px 24px;
      }

      @media (min-width: 640px) {
        .header-inner {
          padding: 16px 40px;
        }
      }

      .brand {
        display: flex;
        align-items: baseline;
        gap: 12px;
      }

      .brand-name {
        font-family: var(--font-display);
        font-size: 18px;
        text-transform: uppercase;
      }

      .brand-sub {
        display: none;
        font-family: var(--font-mono);
        font-size: 10px;
        line-height: 1.35;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        color: var(--muted);
      }

      @media (min-width: 1024px) {
        .brand-sub {
          display: block;
        }
      }

      .desktop-nav {
        display: none;
        align-items: center;
        gap: 24px;
      }

      @media (min-width: 768px) {
        .desktop-nav {
          display: flex;
        }
      }

      .nav-link {
        position: relative;
        font-family: var(--font-mono);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--muted);
        transition: color 0.2s;
      }

      .nav-link::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -5px;
        height: 1px;
        width: 0;
        background: var(--primary);
        transition: width 0.3s;
      }

      .nav-link:hover {
        color: var(--fg);
      }

      .nav-link:hover::after {
        width: 100%;
      }

      .btn-cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--primary);
        color: #0a0a0a;
        padding: 10px 16px;
        font-family: var(--font-mono);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        white-space: nowrap;
        transition: background 0.2s, color 0.2s;
      }

      .btn-cta:hover {
        background: var(--fg);
        color: var(--bg);
      }

      .menu-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--fg);
        padding: 8px;
        cursor: pointer;
      }

      @media (min-width: 768px) {
        .menu-btn {
          display: none;
        }
      }

      /* Menú móvil */
      .mobile-menu {
        position: fixed;
        inset: 0;
        z-index: 55;
        background: var(--bg);
        display: none;
        flex-direction: column;
      }

      .mobile-menu.open {
        display: flex;
      }

      .mobile-menu-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--border);
        padding: 16px 24px;
      }

      .mobile-menu nav {
        display: flex;
        flex-direction: column;
        padding: 24px 24px 0;
      }

      .mobile-menu nav a {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        border-bottom: 1px solid var(--border);
        padding: 20px 0;
        font-family: var(--font-display);
        font-size: 28px;
        text-transform: uppercase;
      }

      .mobile-menu nav a span {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--primary);
      }

      .mobile-menu-foot {
        padding: 32px 24px;
        font-family: var(--font-mono);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--muted);
      }

      /* ========== 4. PORTADA ========== */
      .hero {
        border-top: none;
        padding-top: 73px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1fr;
      }

      @media (min-width: 1024px) {
        .hero-grid {
          grid-template-columns: 1.02fr 0.98fr;
          min-height: calc(100vh - 73px);
        }
      }

      .hero-left {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 48px;
        padding: 56px 24px 48px;
      }

      @media (min-width: 640px) {
        .hero-left {
          padding: 56px 40px 48px;
        }
      }

      @media (min-width: 1024px) {
        .hero-left {
          padding: 64px 64px 64px 40px;
        }
      }

      .hero h1 {
        margin-top: 28px;
        font-size: clamp(2.6rem, 7.4vw, 5.6rem);
        line-height: 0.92;
      }

      .hero-lead {
        margin-top: 28px;
        max-width: 36ch;
        font-size: 18px;
        line-height: 1.7;
        color: var(--muted);
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px 32px;
        margin-top: 36px;
      }

      .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: var(--primary);
        color: #0a0a0a;
        padding: 16px 28px;
        font-family: var(--font-mono);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        transition: background 0.2s, color 0.2s;
      }

      .btn-primary:hover {
        background: var(--fg);
        color: var(--bg);
      }

      .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid var(--border);
        padding-bottom: 4px;
        font-family: var(--font-mono);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        transition: color 0.2s, border-color 0.2s;
      }

      .btn-ghost:hover {
        color: var(--primary);
        border-color: var(--primary);
      }

      .disciplines {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-top: 1px solid var(--border);
      }

      .disciplines li {
        padding: 16px 0;
        border-color: var(--border);
      }

      .disciplines li:nth-child(odd) {
        border-right: 1px solid var(--border);
        padding-right: 16px;
      }

      .disciplines li:nth-child(even) {
        padding-left: 16px;
      }

      .disciplines li:nth-child(-n + 2) {
        border-bottom: 1px solid var(--border);
      }

      .disciplines .num {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.2em;
        color: var(--primary);
      }

      .disciplines .label {
        margin-top: 4px;
        font-size: 14px;
        font-weight: 500;
      }

      .disciplines .detail {
        font-family: var(--font-mono);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--muted);
      }

      /* Columna visual de la portada */
      .hero-visual {
        position: relative;
        min-height: 64vh;
        overflow: hidden;
        border-top: 1px solid var(--border);
      }

      @media (min-width: 1024px) {
        .hero-visual {
          min-height: 100%;
          border-top: none;
          border-left: 1px solid var(--border);
        }
      }

      .hero-backdrop {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.6;
      }

      .hero-shade {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, var(--bg), rgba(10, 10, 10, 0.4), transparent);
      }

      @media (min-width: 1024px) {
        .hero-shade {
          background: linear-gradient(to right, var(--bg), rgba(10, 10, 10, 0.1), transparent);
        }
      }

      .hero-lines {
        position: absolute;
        top: 0;
        bottom: 0;
        left: -56px;
        width: calc(100% + 56px);
        opacity: 0.25;
        background-image: repeating-linear-gradient(
          90deg,
          var(--primary) 0px,
          var(--primary) 2px,
          transparent 2px,
          transparent 14px
        );
        animation: drift 16s linear infinite;
      }

      @keyframes drift {
        from {
          transform: translate3d(-56px, 0, 0);
        }
        to {
          transform: translate3d(0, 0, 0);
        }
      }

      .hero-portrait {
        position: absolute;
        right: 24px;
        bottom: 32px;
        width: 66%;
        max-width: 340px;
      }

      @media (min-width: 640px) {
        .hero-portrait {
          right: 40px;
        }
      }

      @media (min-width: 1024px) {
        .hero-portrait {
          right: 48px;
          bottom: 48px;
        }
      }

      .hero-portrait-frame {
        position: relative;
        overflow: hidden;
        background: var(--card);
        clip-path: polygon(1% 4%, 97% 0%, 100% 93%, 92% 100%, 8% 97%, 0% 46%);
      }

      .hero-portrait img {
        width: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
      }

      .hero-portrait-shadow {
        position: absolute;
        inset: 0;
        transform: translate(12px, 12px);
        background: var(--primary);
      }

      .hero-portrait-caption {
        position: relative;
        margin-top: 12px;
        font-family: var(--font-mono);
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        color: var(--muted);
      }

      /* ========== 5. SOBRE MÍ ========== */
      .about-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 48px;
      }

      @media (min-width: 1024px) {
        .about-grid {
          grid-template-columns: 0.85fr 1.15fr;
          gap: 64px;
        }
      }

      .about-photo {
        position: relative;
      }

      .about-photo-frame {
        position: absolute;
        inset: 0;
        transform: translate(12px, 12px);
        border: 1px solid var(--primary);
      }

      .about-photo img {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
      }

      .about-photo-meta {
        display: flex;
        justify-content: space-between;
        margin-top: 24px;
        font-family: var(--font-mono);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        color: var(--muted);
      }

      .about h2 {
        margin-top: 24px;
        font-size: clamp(2.1rem, 5vw, 3.8rem);
      }

      .about-text {
        margin-top: 32px;
        display: grid;
        gap: 24px;
        font-size: 18px;
        line-height: 1.75;
        color: var(--muted);
      }

      .about-goal {
        margin-top: 40px;
        border-top: 1px solid var(--border);
        padding-top: 32px;
      }

      .about-goal h3 {
        font-family: var(--font-mono);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.28em;
        color: var(--primary);
      }

      .about-goal p {
        margin-top: 16px;
        max-width: 58ch;
        font-size: 16px;
        line-height: 1.7;
        color: rgba(245, 245, 245, 0.8);
      }

      .facts {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-top: 40px;
        border-top: 1px solid var(--border);
      }

      .facts > div {
        padding: 24px 0;
      }

      .facts > div + div {
        border-left: 1px solid var(--border);
        padding-left: 16px;
      }

      .facts > div:not(:last-child) {
        padding-right: 16px;
      }

      .facts dt {
        font-family: var(--font-display);
        font-size: 30px;
      }

      @media (min-width: 640px) {
        .facts dt {
          font-size: 36px;
        }
      }

      .facts dd {
        margin-top: 8px;
        font-family: var(--font-mono);
        font-size: 9px;
        line-height: 1.3;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--muted);
      }

      /* ========== 6. TÍTULOS DE SECCIÓN ========== */
      .section-head {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      @media (min-width: 768px) {
        .section-head {
          flex-direction: row;
          align-items: flex-end;
          justify-content: space-between;
        }
      }

      .section-head h2 {
        margin-top: 20px;
        font-size: clamp(2rem, 5vw, 3.8rem);
      }

      .section-head p.intro {
        max-width: 36ch;
        font-size: 16px;
        line-height: 1.7;
        color: var(--muted);
      }

      /* ========== 7. PROYECTOS ========== */
      .projects-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 48px 24px;
        margin-top: 56px;
      }

      @media (min-width: 768px) {
        .projects-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      .project-media {
        position: relative;
        overflow: hidden;
        background: var(--card);
      }

      .project-media img {
        width: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        transition: transform 0.7s ease;
      }

      .project:hover .project-media img {
        transform: scale(1.04);
      }

      .project-media::after {
        content: "";
        position: absolute;
        inset: 0;
        border: 1px solid transparent;
        transition: border-color 0.3s;
      }

      .project:hover .project-media::after {
        border-color: var(--primary);
      }

      .project-badge {
        position: absolute;
        top: 16px;
        left: 16px;
        display: inline-flex;
        gap: 8px;
        background: rgba(10, 10, 10, 0.85);
        padding: 6px 12px;
        font-family: var(--font-mono);
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.2em;
      }

      .project-badge span {
        color: var(--primary);
      }

      .project-body {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        margin-top: 20px;
        border-top: 1px solid var(--border);
        padding-top: 20px;
      }

      .project-body h3 {
        font-family: var(--font-display);
        font-size: 20px;
        line-height: 1.15;
        text-transform: uppercase;
        transition: color 0.2s;
      }

      .project:hover .project-body h3 {
        color: var(--primary);
      }

      @media (min-width: 640px) {
        .project-body h3 {
          font-size: 24px;
        }
      }

      .project-body p {
        margin-top: 12px;
        max-width: 52ch;
        font-size: 14px;
        line-height: 1.7;
        color: var(--muted);
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
      }

      .tags li {
        border: 1px solid var(--border);
        padding: 4px 10px;
        font-family: var(--font-mono);
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--muted);
      }

      .project-year {
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.2em;
        color: var(--muted);
      }

      /* ========== 8. SERVICIOS ========== */
      .services-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 48px;
      }

      @media (min-width: 1024px) {
        .services-grid {
          grid-template-columns: 0.6fr 1.4fr;
          gap: 64px;
        }
      }

      .services-intro h2 {
        margin-top: 20px;
        font-size: clamp(2rem, 4.6vw, 3.4rem);
      }

      .services-intro p {
        margin-top: 24px;
        max-width: 30ch;
        font-size: 16px;
        line-height: 1.7;
        color: var(--muted);
      }

      .services-list {
        border-top: 1px solid var(--border);
      }

      .services-list li {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        border-bottom: 1px solid var(--border);
        padding: 28px 0;
        transition: border-color 0.2s;
      }

      .services-list li:hover {
        border-color: var(--primary);
      }

      .services-list .num {
        margin-top: 4px;
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.2em;
        color: var(--primary);
      }

      .services-list h3 {
        font-size: 18px;
        font-weight: 500;
        line-height: 1.4;
        transition: color 0.2s;
      }

      @media (min-width: 640px) {
        .services-list h3 {
          font-size: 20px;
        }
      }

      .services-list li:hover h3 {
        color: var(--primary);
      }

      .services-list p {
        margin-top: 8px;
        max-width: 52ch;
        font-size: 14px;
        line-height: 1.7;
        color: var(--muted);
      }

      .services-cta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-top: 40px;
        background: var(--primary);
        color: #0a0a0a;
        padding: 24px 28px;
        font-family: var(--font-mono);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        transition: background 0.2s, color 0.2s;
      }

      .services-cta:hover {
        background: var(--fg);
        color: var(--bg);
      }

      /* ========== 9. HABILIDADES ========== */
      .skills-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 48px 40px;
        margin-top: 56px;
      }

      @media (min-width: 640px) {
        .skills-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (min-width: 1024px) {
        .skills-grid {
          grid-template-columns: repeat(4, 1fr);
        }
      }

      .skill-group {
        border-top: 1px solid var(--border);
        padding-top: 20px;
      }

      .skill-group h3 {
        font-family: var(--font-mono);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.24em;
      }

      .skill-group ul {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 20px;
      }

      .skill-group li {
        border: 1px solid var(--border);
        padding: 6px 12px;
        font-family: var(--font-mono);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--muted);
        transition: all 0.2s;
      }

      .skill-group li:hover {
