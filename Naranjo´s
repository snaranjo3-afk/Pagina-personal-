      .field select,
      .field textarea {
        width: 100%;
        margin-top: 8px;
        border: none;
        border-bottom: 1px solid var(--border);
        background: transparent;
        padding: 12px 0;
        font-family: var(--font-body);
        font-size: 14px;
        color: var(--fg);
        outline: none;
        transition: border-color 0.2s;
